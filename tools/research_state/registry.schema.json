{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://histo-orla.local/schema/research-state-spine-v0.1.json",
  "title": "Histo-Orla Research State Identity/Owner/Reference Spine v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "records"],
  "properties": {
    "schema_version": {"const": "0.1"},
    "records": {
      "type": "array",
      "items": {"$ref": "#/$defs/record"}
    }
  },
  "$defs": {
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "role", "canonical_ref"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "role": {
          "enum": ["source", "representation", "instance", "findspot", "finding"]
        },
        "canonical_ref": {"type": "string", "minLength": 3}
      }
    }
  }
}
