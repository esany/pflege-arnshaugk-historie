{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://histo-orla.local/schema/requirement-assurance-records-v0.1.json",
  "title": "Histo-Orla Requirements Assurance Records v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "records"],
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "records": {
      "type": "array",
      "items": {"$ref": "#/$defs/record"}
    }
  },
  "$defs": {
    "relation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "target"],
      "properties": {
        "type": {
          "enum": [
            "derived_from",
            "requires",
            "refines",
            "constrains",
            "conflicts_with",
            "supersedes",
            "related_to"
          ]
        },
        "target": {
          "type": "string",
          "pattern": "^REQ-[A-Z]+-[0-9]{3}$"
        },
        "note": {"type": "string"}
      }
    },
    "interaction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "with", "note"],
      "properties": {
        "type": {
          "enum": [
            "reinforcing",
            "constraint",
            "trade-off",
            "shared-enabler",
            "shared-failure-domain",
            "verification-coupling",
            "rights-security-coupling",
            "domain-coupling"
          ]
        },
        "with": {
          "type": "string",
          "pattern": "^REQ-[A-Z]+-[0-9]{3}$"
        },
        "note": {"type": "string", "minLength": 1}
      }
    },
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "source_file",
        "lifecycle_owner",
        "domain_authority",
        "technical_delivery_competence",
        "verification_authority",
        "dependency_status",
        "relations",
        "interactions",
        "criticality",
        "architecture_significance",
        "verification_methods",
        "verification_evidence_refs",
        "decision_refs"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^REQ-[A-Z]+-[0-9]{3}$"
        },
        "source_file": {
          "type": "string",
          "pattern": "^docs/research/synthesis/requirements-(baseline|extensions)\\.md$"
        },
        "lifecycle_owner": {
          "const": "#42"
        },
        "domain_authority": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "controlling_competence": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1},
          "default": []
        },
        "technical_delivery_competence": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "verification_authority": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "dependency_status": {
          "enum": ["known", "none-known", "unresolved"]
        },
        "relations": {
          "type": "array",
          "items": {"$ref": "#/$defs/relation"}
        },
        "interactions": {
          "type": "array",
          "items": {"$ref": "#/$defs/interaction"}
        },
        "criticality": {
          "enum": ["hard-constraint", "fundamental", "important", "enhancement"]
        },
        "architecture_significance": {
          "enum": ["cross-cutting", "bounded", "local", "unknown/research-needed"]
        },
        "verification_methods": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "deterministic-test",
              "integration-roundtrip",
              "benchmark-gold-corpus",
              "real-case-acceptance",
              "domain-method-review",
              "owner-workflow-acceptance",
              "independent-specialist-validation",
              "rights-security-review"
            ]
          }
        },
        "verification_evidence_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "decision_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "notes": {"type": "string"}
      },
      "allOf": [
        {
          "if": {
            "properties": {"dependency_status": {"const": "known"}},
            "required": ["dependency_status"]
          },
          "then": {
            "properties": {"relations": {"minItems": 1}}
          }
        },
        {
          "if": {
            "properties": {"dependency_status": {"const": "none-known"}},
            "required": ["dependency_status"]
          },
          "then": {
            "properties": {"relations": {"maxItems": 0}}
          }
        }
      ]
    }
  }
}
