{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/esany/pflege-arnshaugk-historie/blob/main/docs/development/work-orders/codex-rebuild-execution-contract.schema.json",
  "title": "Bounded Rebuild Execution Contract",
  "type": "object",
  "required": ["schema_version", "work_order_ref", "work_owner_ref", "primary_function", "causal_driver_slice", "authority", "accepted_requirements", "scope", "minimal_context", "tests", "stop_handoff_when", "persistence_target", "return_contract", "non_goals"],
  "properties": {
    "schema_version": {"const": "0.1"},
    "work_order_ref": {"type": "string", "minLength": 1},
    "work_owner_ref": {"type": "string", "minLength": 1},
    "primary_function": {"type": "string", "minLength": 1},
    "causal_driver_slice": {"type": "object", "required": ["goal_refs", "need_refs", "pain_refs", "constraint_refs"], "properties": {"goal_refs": {"type": "array", "items": {"type": "string"}}, "need_refs": {"type": "array", "items": {"type": "string"}}, "pain_refs": {"type": "array", "items": {"type": "string"}}, "constraint_refs": {"type": "array", "items": {"type": "string"}}}, "additionalProperties": false},
    "authority": {"type": "object", "required": ["work_owner_ref", "semantic_authority_refs", "acceptance_authority_refs"], "additionalProperties": false},
    "accepted_requirements": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["id", "acceptance_refs", "verification_refs"], "additionalProperties": false}},
    "scope": {"type": "object", "required": ["included_files", "excluded_paths"], "additionalProperties": false},
    "minimal_context": {"type": "object", "required": ["max_refs", "required_refs"], "additionalProperties": false},
    "tests": {"type": "array", "minItems": 1},
    "stop_handoff_when": {"type": "array", "minItems": 1},
    "persistence_target": {"type": "string", "minLength": 1},
    "return_contract": {"type": "object", "required": ["format", "required_fields", "handoff_fields"], "additionalProperties": false},
    "non_goals": {"type": "array", "minItems": 1}
  },
  "additionalProperties": false
}
